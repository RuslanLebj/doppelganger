SERVICE_NAME=doppelganger
DATA_DIR=data/app
# Set the server interface IP to allow remote access to the API.
API_BIND_HOST=127.0.0.1
# Fill secrets manually. Keep this file private and outside Git.
CRYPT_KEY=
API_KEY=

# Admin sign-in. Set password and a separate random session-signing key.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET_KEY=
ADMIN_COOKIE_SECURE=false

# Metadata PostgreSQL, separate from the source databases.
POSTGRES_DB_HOST=127.0.0.1
POSTGRES_DB_PORT=55432
POSTGRES_DB_NAME=doppelganger
POSTGRES_DB_USER=doppelganger
POSTGRES_DB_PASSWORD=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
POSTGRES_SSLMODE=prefer

# Local AIStor Free. Compose overrides the endpoint.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=doppelganger
S3_PREFIX=postgres-backups
S3_REGION=us-east-1
S3_ACCESS_KEY=doppelganger-local
S3_SECRET_KEY=
# History expires after 7 days; latest/ is kept indefinitely.
RETENTION_DAYS=7
# MINIO_LICENSE_FILE=../secrets/minio.license

BACKUP_EXECUTION_ENABLED=false
MIN_FREE_BYTES=10737418240
STORAGE_TIMEOUT_SECONDS=14400
PG_DUMP_COMMAND=pg_dump
DUMP_COMPRESSION_LEVEL=1
